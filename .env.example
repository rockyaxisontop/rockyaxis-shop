# Server secret – NEVER prefix with NEXT_PUBLIC_
# Get a key at https://trychannel3.com/dashboard
CHANNEL3_API_KEY=

# Optional: forwarded to Channel3 as the x-user-id header so clicks/sales are
# attributed to a user in your system.
# CHANNEL3_USER_ID=

# Public site URL used for canonical links, sitemap.xml, robots.txt and the
# Open Graph tags. Set this to your custom domain in production, e.g.
#   NEXT_PUBLIC_SITE_URL=https://mtstore.com
# If unset, Vercel's production URL is used (and localhost in development).
# NEXT_PUBLIC_SITE_URL=

# --- Internal messenger (customer chat + /adminhacker) -----------------------
# Admins are decided by the DATABASE, not by env vars: set `role: "admin"` on
# the user's document (Firebase console → users/{uid}). Firestore rules stop a
# user from writing that field themselves.
#
# Web-push public key (Firebase console → Project settings → Cloud Messaging →
# Web Push certificates). Safe to ship in the browser bundle.
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Storage bucket for chat attachments. Defaults to the project's
# default bucket (rockyaxis-shop.firebasestorage.app) when unset.
# FIREBASE_STORAGE_BUCKET=rockyaxis-shop.firebasestorage.app
