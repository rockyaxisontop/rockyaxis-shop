rules_version = '2';

// ============================================================================
// MT Store — Firestore is BACKEND ONLY.
//
// The browser has NO read and NO write access to anything. Every operation goes
// through our own API routes (/api/*) which use the Firebase Admin SDK. The
// Admin SDK bypasses these rules entirely, so this one deny rule is enough.
//
// Why a blanket deny instead of per-collection rules:
//   • a new collection can never be accidentally left readable;
//   • a bug in client code fails closed with PERMISSION_DENIED, not silently
//     exposing data;
//   • there is exactly one place to reason about, which is easier to audit.
//
// Collections in use (all server-only):
//   users, carts, orders, chatOrders, conversations (+ messages, deviceTokens),
//   freebieCampaigns, freebieReferrals, freebieOrders, admins
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
