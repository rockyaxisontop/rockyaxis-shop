rules_version = '2';

// Client-only app: every user may read/write only their own documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid} – profile snapshot written right after sign-up.
    match /users/{uid} {
      allow read: if isOwner(uid);

      // A user may save their own profile EXCEPT for the fields that decide
      // access. `role` and `disabled` can only be changed by the server (Admin
      // SDK), otherwise anyone could make themselves an administrator by
      // writing {"role": "admin"} with the Firestore REST API.
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'disabled']);

      allow create: if isOwner(uid)
                    && request.resource.data.get('role', 'user') != 'admin'
                    && !request.resource.data.keys().hasAny(['disabled']);

      allow delete: if isOwner(uid);

      // Push registration tokens live here for admins.
      match /deviceTokens/{token} {
        allow read, write: if false;
      }
    }

    // admins/{uid} – legacy allow-list. Kept closed; the admin role now lives on
    // users/{uid}.role, which only the server can set.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // carts/{uid}/items/{itemId} – live cart, private per user.
    match /carts/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // orders/{uid}/history/{orderId} – past orders kept after checkout.
    match /orders/{uid}/history/{orderId} {
      allow read, create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Freebie referral system — SERVER ONLY.
    //
    // Every read and write goes through /api/freebies/* using the Admin SDK,
    // which bypasses these rules. Clients are denied outright so nobody can
    // forge a referral count, mark a campaign complete, or read someone
    // else's progress by calling the Firestore REST API directly.
    // ---------------------------------------------------------------------
    match /freebieCampaigns/{campaignId} {
      allow read, write: if false;
    }

    match /freebieReferrals/{referralId} {
      allow read, write: if false;
    }

    match /freebieOrders/{orderId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Internal messenger — SERVER ONLY.
    //
    // All access goes through /api/messages/* and /api/admin/* using the Admin
    // SDK. Clients are denied outright so nobody can read another customer's
    // messages, forge read receipts or clear their own unread count.
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
      // Push tokens; registered through our API only.
      match /deviceTokens/{token} {
        allow read, write: if false;
      }
    }
  }
}
