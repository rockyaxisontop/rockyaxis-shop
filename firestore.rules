rules_version = '2';

// Backend-only data model.
//
// Every read and write goes through /api/* using the Admin SDK (which bypasses
// these rules). Nothing in the app talks to Firestore from the browser any more,
// so a client is denied by default and only the signed-in user's own *safe*
// documents remain accessible as a fallback.
//
// Verified: /api/cart, /api/profile, /api/messages/*, /api/admin/*, /api/freebies/*.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid} – SERVER ONLY now (/api/profile). Closed outright so a client
    // can never read another profile or grant itself a role.
    match /users/{uid} {
      allow read, write: if false;
      match /deviceTokens/{token} {
        allow read, write: if false;
      }
    }

    // admins/{uid} – legacy allow-list. Kept closed; the admin role now lives on
    // users/{uid}.role, which only the server can set.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // carts/{uid}/items/{itemId} – SERVER ONLY now (/api/cart).
    match /carts/{uid}/items/{itemId} {
      allow read, write: if false;
    }

    // orders/{uid}/history/{orderId} – kept closed; orders flow through the API.
    match /orders/{uid}/history/{orderId} {
      allow read, write: if false;
    }

    // Chat orders (status per reference) — server only.
    match /chatOrders/{reference} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Freebie referral system — SERVER ONLY.
    //
    // Every read and write goes through /api/freebies/* using the Admin SDK,
    // which bypasses these rules. Clients are denied outright so nobody can
    // forge a referral count, mark a campaign complete, or read someone
    // else's progress by calling the Firestore REST API directly.
    // ---------------------------------------------------------------------
    match /freebieCampaigns/{campaignId} {
      allow read, write: if false;
    }

    match /freebieReferrals/{referralId} {
      allow read, write: if false;
    }

    match /freebieOrders/{orderId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Internal messenger — SERVER ONLY.
    //
    // All access goes through /api/messages/* and /api/admin/* using the Admin
    // SDK. Clients are denied outright so nobody can read another customer's
    // messages, forge read receipts or clear their own unread count.
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
      // Push tokens; registered through our API only.
      match /deviceTokens/{token} {
        allow read, write: if false;
      }
    }
  }
}
