rules_version = '2';

// Client-only app: every user may read/write only their own documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid} – profile snapshot written right after sign-up.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // carts/{uid}/items/{itemId} – live cart, private per user.
    match /carts/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // orders/{uid}/history/{orderId} – past orders kept after checkout.
    match /orders/{uid}/history/{orderId} {
      // Order records, especially zero-price referral orders, are written by
      // the trusted server only. Clients can read their own history.
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // Referral campaigns and claims are server-managed. Never trust a client
    // to increment progress or mark a campaign complete.
    match /freebieCampaigns/{document=**} {
      allow read, write: if false;
    }
    match /freebieCampaignIndexes/{document=**} {
      allow read, write: if false;
    }
    match /freebieReferralClaims/{document=**} {
      allow read, write: if false;
    }
  }
}
