rules_version = '2';

// Client-only app: every user may read/write only their own documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid} – profile snapshot written right after sign-up.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // carts/{uid}/items/{itemId} – live cart, private per user.
    match /carts/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // orders/{uid}/history/{orderId} – past orders kept after checkout.
    match /orders/{uid}/history/{orderId} {
      allow read, create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Freebie referral system — SERVER ONLY.
    //
    // Every read and write goes through /api/freebies/* using the Admin SDK,
    // which bypasses these rules. Clients are denied outright so nobody can
    // forge a referral count, mark a campaign complete, or read someone
    // else's progress by calling the Firestore REST API directly.
    // ---------------------------------------------------------------------
    match /freebieCampaigns/{campaignId} {
      allow read, write: if false;
    }

    match /freebieReferrals/{referralId} {
      allow read, write: if false;
    }

    match /freebieOrders/{orderId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Internal messenger — SERVER ONLY.
    //
    // All access goes through /api/messages/* and /api/admin/* using the Admin
    // SDK. Clients are denied outright so nobody can read another customer's
    // messages, forge read receipts, clear their unread count, or grant
    // themselves the admin role by writing to /admins.
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /admins/{uid} {
      // Admins may read their own role document; nobody may write it from the
      // client. Roles are granted server-side from the ADMIN_EMAILS allow-list.
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
